---
import "../../styles/global.css";
import RecipeActions from "../../components/RecipeActions.astro";

const navItems = [
  { href: "/", label: "Главная" },
  { href: "/kitchen/", label: "Кухня" },
  { href: "/night-tales/", label: "Предания" },
  { href: "/podcast/", label: "Подкаст" },
  { href: "/#contacts", label: "Контакты" },
];

const symbolism = [
  {
    title: "Основа",
    text: "Цилиндр из ганаша — мир смертных, приземленный и неизменный.",
  },
  {
    title: "Купол",
    text: "Полусфера из мусса — божественный непреложный порядок.",
  },
  {
    title: "Окулус",
    text: "Вырезанное отверстие — разрыв, откровение, окно, куда осмелился заглянуть человек.",
  },
  {
    title: "Осколок",
    text: "Капля золотистой карамели или съедобное перо — смертный, который осмелился слушать.",
  },
];

const flavors = [
  "Первым приходит темный шоколад — власть, тяжесть, ночь.",
  "Затем появляется мягкий, почти неподвижный мусс — порядок, который кажется вечным.",
  "Апельсин и имбирь прорывают эту неподвижность — ясность, огонь, внезапное понимание.",
  "Перец остается в послевкусии — цена любопытства.",
  "Золото ничего не подслащивает и ничего не улучшает. Оно только подтверждает: человек действительно увидел то, чего не должен был видеть.",
];

const recipeBlocks = [
  {
    title: "Какао-сабле",
    ingredients: [
      "сливочное масло — 55 г",
      "сахарная пудра — 35 г",
      "миндальная мука — 20 г",
      "желток — 20 г",
      "пшеничная мука — 75 г",
      "какао — 15 г",
      "соль — 1 г",
    ],
    steps: [
      "Мягкое масло растереть с сахарной пудрой и солью. Добавить миндальную муку и желток, затем муку с какао. Быстро собрать тесто, не вымешивая его долго.",
      "Раскатать между двумя листами бумаги до толщины 3 мм и охладить не менее часа.",
      "Выпекать при 160 °C около 12–14 минут. Еще теплый пласт вырезать кольцом диаметром 6,5 см. Обрезки сохранить: из них получится шоколадная «земля» для подачи.",
    ],
  },
  {
    title: "Апельсиново-имбирный конфитюр",
    ingredients: [
      "апельсиновое пюре — 120 г",
      "мякоть апельсина без пленок, мелким кубиком — 50 г",
      "сахар — 35 г",
      "пектин NH — 3 г",
      "свежий имбирь, мелко натертый — 5–6 г",
      "лимонный сок — 8 г",
    ],
    steps: [
      "Сахар смешать с пектином.",
      "Апельсиновое пюре нагреть с имбирем примерно до 40 °C. Дождем всыпать сахар с пектином, постоянно размешивая венчиком. Довести до кипения и проварить около минуты.",
      "Снять с огня, добавить апельсиновую мякоть и лимонный сок.",
      "Разлить в маленькие полусферы диаметром 18–20 мм или в форму для небольших дисков. Заморозить.",
      "Конфитюр должен быть ярким и достаточно кислым: он будет единственным источником света внутри темного десерта.",
    ],
  },
  {
    title: "Ганаш для цилиндра",
    ingredients: [
      "темный шоколад 70% — 230 г",
      "сливки 33–35% — 180 г",
      "глюкозный сироп — 25 г",
      "сливочное масло — 25 г",
      "соль — 1 г",
      "черный перец или пимент д’Эспелет — около 0,2 г",
    ],
    steps: [
      "Сливки нагреть с глюкозой почти до кипения.",
      "Вылить на шоколад в три приема, каждый раз создавая эластичную блестящую эмульсию. При температуре около 35–38 °C добавить масло, соль и совсем небольшую щепотку перца. Пробить погружным блендером, не захватывая воздух.",
      "Кольца диаметром 6,5 см и высотой около 2 см выстелить ацетатной пленкой. На дно каждого положить диск сабле.",
      "Распределить ганаш слоем примерно 18–20 мм. Заморозить.",
      "Перец не должен ощущаться как отдельная приправа. Он должен появляться только в послевкусии — как момент опасности после первоначальной шоколадной устойчивости.",
    ],
  },
  {
    title: "Шоколадный мусс для купола",
    ingredients: [
      "молоко — 140 г",
      "желтки — 40 г",
      "сахар — 25 г",
      "желатин — 3 г",
      "вода для желатина — 18 г",
      "темный шоколад 66–70% — 180 г",
      "сливки 33–35% — 280 г",
    ],
    steps: [
      "Желатин замочить в холодной воде.",
      "Желтки перемешать с сахаром. Молоко нагреть, постепенно влить в желтки, вернуть смесь в сотейник и приготовить английский крем до 82–83 °C.",
      "Снять с огня, растворить желатин. Вылить крем на шоколад и сделать эмульсию. Остудить шоколадную основу до 36–38 °C.",
      "Сливки взбить до мягких форм — они должны оставаться пластичными, а не стоять плотными пиками. Ввести их в шоколадную массу в два-три приема.",
    ],
  },
];

const assemblySteps = [
  {
    title: "Формирование купола",
    steps: [
      "Полусферические формы диаметром 6,5–7 см заполнить муссом примерно на две трети.",
      "Замороженный апельсиновый конфитюр поместить не в центр, а ближе к одной из стенок формы. Между конфитюром и поверхностью будущего купола должно оставаться примерно 4–6 мм мусса.",
      "Отметить положение вставки снаружи формы: именно здесь позднее будет сделан окулус.",
      "Дополнить форму муссом, выровнять и заморозить не менее чем на 8 часов.",
      "Достать полусферы из формы и установить на замороженные цилиндры ганаша. Место соединения аккуратно сгладить небольшим количеством мусса или ганаша. Снова хорошо заморозить.",
    ],
  },
  {
    title: "Черный шоколадный велюр",
    ingredients: ["темный шоколад — 100 г", "какао-масло — 100 г"],
    steps: [
      "Растопить шоколад с какао-маслом и использовать смесь при температуре около 40–45 °C.",
      "Распылить на полностью замороженные десерты. Поверхность должна получиться матовой, почти каменной, без блеска. Можно нанести покрытие немного неравномерно: легкая шероховатость сделает форму похожей на древний архитектурный объект.",
    ],
  },
  {
    title: "Окулус",
    steps: [
      "Металлическую вырубку диаметром 16–18 мм слегка нагреть.",
      "В отмеченной точке осторожно вырезать круглое отверстие в велюре и верхнем слое мусса. Не прорезать купол насквозь: остановиться, как только появится апельсиновый конфитюр.",
      "Края отверстия оставить немного неровными. Слишком идеальный круг будет выглядеть как заводской декор, а здесь нужен след вмешательства — будто оболочка была раскрыта силой.",
      "Открытую поверхность конфитюра покрыть тонким слоем нейтральной глазури. Внутрь поместить небольшой фрагмент сусального золота.",
      "Из отверстия может стекать одна тонкая капля апельсинового геля или карамели — как след услышанного откровения.",
    ],
  },
  {
    title: "Золотой осколок",
    ingredients: ["изомальт — 100 г", "золотой пищевой кандурин — немного"],
    steps: [
      "Изомальт расплавить примерно до 165–170 °C. Вылить очень тонким слоем на силиконовый коврик. Пока масса еще пластична, можно слегка вытянуть ее в форму пера или длинного обломка.",
      "После застывания разбить на неровные фрагменты. Часть поверхности едва коснуться золотым кандурином.",
      "Один осколок установить рядом с окулусом или положить у основания десерта. Он не должен выглядеть короной или драгоценностью — это именно фрагмент, вынесенный изнутри.",
    ],
  },
];

const serving = [
  "Обрезки какао-сабле раскрошить и расположить вокруг основания как темную землю или обломки разрушенной стены. Можно добавить несколько более крупных кусков бисквита или шоколадного крамбла.",
  "Размораживать десерт 4–5 часов в холодильнике. Изомальтовый осколок устанавливать перед самой подачей, поскольку он быстро впитывает влагу.",
  "Подавать не ледяным: после холодильника дать десерту постоять около 10 минут. Тогда ганаш станет пластичным, мусс — шелковистым, а апельсиново-имбирный центр проявится значительно ярче.",
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Éclat d’Interdit — первый десерт кухонной линии KAIGHI: шоколадный купол о запрете, ночи, власти и откровении."
    />
    <title>Éclat d’Interdit — KAIGHI</title>
  </head>
  <body class="recipe-page">
    <header class="site-header recipe-header" aria-label="Навигация рецепта">
      <a class="brand" href="/" aria-label="KAIGHI">KAIGHI</a>
      <nav>
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>

    <main>
      <article class="recipe-story">
        <header class="recipe-hero">
          <div>
            <a class="story__back" href="/kitchen/">Назад в Кухню</a>
            <p class="section-kicker">Ночью — миф. Днем — десерт.</p>
            <h1>Éclat d’Interdit</h1>
          </div>
          <p>
            Шоколадный купол о запрете, власти и моменте, когда смертный
            осмеливается услышать слишком простую правду богов.
          </p>
        </header>

        <figure class="recipe-photo">
          <img
            src="/images/eclat-interdit.jpg"
            alt="Шоколадный десерт Éclat d’Interdit с темным куполом и карамельным окулусом"
          />
          <figcaption>
            Гладкий темный купол, горьковато-пряная середина и карамельный
            разрыв как окно в запретное знание.
          </figcaption>
        </figure>

        <section class="recipe-intro grid-section">
          <div>
            <p class="section-kicker">Утреннее размышление</p>
            <h2>Форма после ночного мифа</h2>
          </div>
          <p>
            Я проснулась со вкусом угля и апельсиновой цедры. Это был не кошмар,
            а новая мысль, которая должна была получить форму. Гладкий купол —
            темный, совершенный снаружи и, как истина, горьковато-пряный внутри.
          </p>
        </section>

        <section class="recipe-yield">
          <p class="section-kicker">Рецепт «Пантеон»</p>
          <p>На 6 индивидуальных десертов диаметром 6,5–7 см.</p>
        </section>

        <section class="recipe-details">
          <div>
            <p class="section-kicker">Символизм</p>
            <div class="recipe-symbols">
              {symbolism.map((item) => (
                <article>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </article>
              ))}
            </div>
          </div>

          <aside class="recipe-flavors">
            <p class="section-kicker">Вкусовой профиль</p>
            <ul>
              {flavors.map((flavor) => <li>{flavor}</li>)}
            </ul>
          </aside>
        </section>

        <section class="recipe-method" aria-label="Технологическая карта">
          <div class="section-heading">
            <p class="section-kicker">Технология</p>
            <h2>Как собрать десерт</h2>
          </div>

          <div class="recipe-method__list">
            {recipeBlocks.map((block) => (
              <article class="recipe-method__block">
                <h3>{block.title}</h3>
                <div class="recipe-method__content">
                  <div class="recipe-method__ingredients">
                    <p class="recipe-method__label">Ингредиенты</p>
                    <ul>
                      {block.ingredients.map((ingredient) => <li>{ingredient}</li>)}
                    </ul>
                  </div>
                  <div class="recipe-method__steps">
                    <p class="recipe-method__label">Способ</p>
                    {block.steps.map((step) => <p>{step}</p>)}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="recipe-method recipe-method--assembly" aria-label="Сборка и подача">
          <div class="section-heading">
            <p class="section-kicker">Сборка</p>
            <h2>Окулус, велюр и золотой осколок</h2>
          </div>

          <div class="recipe-method__list">
            {assemblySteps.map((block) => (
              <article class="recipe-method__block">
                <h3>{block.title}</h3>
                <div class={block.ingredients ? "recipe-method__content" : "recipe-method__content recipe-method__content--steps-only"}>
                  {block.ingredients ? (
                    <div class="recipe-method__ingredients">
                      <p class="recipe-method__label">Ингредиенты</p>
                      <ul>
                        {block.ingredients.map((ingredient) => <li>{ingredient}</li>)}
                      </ul>
                    </div>
                  ) : null}
                  <div class="recipe-method__steps">
                    <p class="recipe-method__label">Способ</p>
                    {block.steps.map((step) => <p>{step}</p>)}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="recipe-serving grid-section">
          <div>
            <p class="section-kicker">Подача</p>
            <h2>Темная земля и время оттаивания</h2>
          </div>
          <div>
            {serving.map((item) => <p>{item}</p>)}
          </div>
        </section>

        <section class="recipe-link">
          <p>
            Связанный миф:
            <a class="text-link" href="/night-tales/zeus-hypnos-i-tot-kto-nochyu-ne-spal/">
              «Зевс, Гипнос и Тот, Кто Ночью Не Спал»
            </a>.
            Десерт остается его дневной формой.
          </p>
        </section>

        <RecipeActions title="Éclat d’Interdit" />
      </article>
    </main>

    <footer class="recipe-footer">
      <div>
        <span>KAIGHI</span>
        <p>Кухня как продолжение мифа</p>
      </div>
      <nav aria-label="Нижняя навигация">
        <a href="/">Главная</a>
        <a href="/kitchen/">Кухня</a>
        <a href="/night-tales/">Предания</a>
        <a href="mailto:hello@kaighi.org">hello@kaighi.org</a>
      </nav>
    </footer>
  </body>
</html>
