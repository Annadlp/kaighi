---
import "../../styles/global.css";
import RecipeActions from "../../components/RecipeActions.astro";

const navItems = [
  { href: "/", label: "Главная" },
  { href: "/kitchen/", label: "Кухня" },
  { href: "/night-tales/", label: "Предания" },
  { href: "/podcast/", label: "Подкаст" },
  { href: "/#contacts", label: "Контакты" },
];

const story = [
  "Когда-то, наверное, в конце 80-х годов мама купила книгу под названием «500 блюд для северян», выпущенную Магаданским книжным издательством.",
  "В ней не было иллюстраций блюд, не были указаны температуры выпечки, хотя о какой точной температуре можно было говорить с тогдашними духовками. Но я ее читала с большим интересом: очень много было нового, и за блюда со странными названиями «волованы» и «птифуры» я даже не помышляла браться.",
  "Для многих блюд не было ингредиентов, и я с досадой думала, зачем нужно было в книгу блюд для северян включать рецепты с продуктами, которых не было в продаже.",
  "Начала готовить по наиболее простым рецептам с доступными продуктами - так приготовила азу, которое очень всем понравилось, печенье «Поленце» и вот эти рогалики. Да, почему я выбрала именно этот рецепт: для теста не нужны были яйца, которые тогда было сложно достать.",
];

const originalRecipe = {
  ingredients: [
    "сметана — 200 г",
    "маргарин — 200 г",
    "мука — 3 1/2 стакана",
    "начинка — сладкая",
  ],
  steps: [
    "Замесите тесто из сметаны, маргарина и муки.",
    "Разделите на 4 части. Из каждой раскатайте круг и поделите его на 8 частей по радиусам.",
    "Положите сладкую начинку: варенье, изюм с орехами. Сверните от широкой части к кончику, в центр круга.",
    "Придайте форму рога, уложите на противень и выпекайте, посыпав сахарной пудрой.",
  ],
};

const memory = [
  "Изюма с орехами у меня не было, зато было немного варенья и творог. Я смешала творог с вареньем и начинила рогалики. Это оказалось вкусно.",
  "Потом я очень гордилась своим изобретением, потому что не видела до этого, чтобы кто-то смешивал творог с вареньем. Не помню, посыпала ли я рогалики сахарной пудрой, скорее всего, нет. Но и в таком виде рогалики понравились и мне, и всем, кто их пробовал.",
  "Сегодня я испекла их точно по этому рецепту, с маргарином, хотя я теперь обычно не использую маргарин, и с начинкой из творога с клубничным вареньем. Хотелось попробовать вкус детства.",
];

const notes = [
  "Маргарин, конечно, не замена сливочному маслу, и аромат рогаликов при выпечке превосходит их вкус.",
  "Тесто с маргарином и сметаной получается слегка слоеное, на вкус пресноватое, лучше добавить немного соли.",
  "Так как температура выпечки в рецепте не указана, я выпекала при 180 °C. Рогалики простояли в духовке дольше, чем я ожидала: минут 25–30.",
  "Лучше смазать рогалики перед выпечкой яйцом либо льезоном, чтобы они зарумянились.",
  "Начинка необязательно должна быть сладкой: можно положить творог с зеленью, сыр или что-то другое. Тогда не нужно посыпать их сахарной пудрой.",
];

const afterword = [
  "Потом, спустя много лет, я решила сделать дома круассаны, которые впервые попробовала в Женеве. Рецепта я не могла найти нигде, тогда еще не было больших кулинарных порталов, и никто не помышлял о том, чтобы слоить тесто в домашних условиях.",
  "Рецепт я нашла в чьем-то «Живом Журнале» - было такое интернет-явление в начале 2000-х. С тех пор началось мое увлечение выпечкой, которое само породило много отдельных историй.",
  "Сейчас, пока писала этот небольшой рассказ, подумала, что я ведь никогда, ни разу, не видела, чтобы моя мама что-то готовила по этой странной книге рецептов. Эта книга просто в один день появилась у нас дома так, чтобы я начала ее читать.",
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Рогалики из книги «500 блюд для северян» — кухонная запись KAIGHI о первом рецепте, доступных продуктах и вкусе детства."
    />
    <title>Рогалики — KAIGHI</title>
  </head>
  <body class="recipe-page">
    <header class="site-header recipe-header" aria-label="Навигация рецепта">
      <a class="brand" href="/" aria-label="KAIGHI">KAIGHI</a>
      <nav>
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>

    <main>
      <article class="recipe-story">
        <header class="recipe-hero">
          <div>
            <a class="story__back" href="/kitchen/">Назад в Кухню</a>
            <p class="section-kicker">Почему появилась кухня</p>
            <h1>Рогалики</h1>
          </div>
          <p>
            Семейная запись о книге «500 блюд для северян», рецептах без
            иллюстраций, продуктах, которые было трудно достать, и первой
            собственной начинке из творога с вареньем.
          </p>
        </header>

        <figure class="recipe-photo">
          <img
            src="/images/rogaliki.jpg"
            alt="Домашние рогалики с сахарной пудрой"
          />
          <figcaption>
            Рогалики по рецепту из старой северной кулинарной книги: сметана,
            маргарин, мука и начинка из того, что было дома.
          </figcaption>
        </figure>

        <section class="recipe-prose grid-section">
          <div>
            <p class="section-kicker">Начало</p>
            <h2>Книга, которая просто появилась дома</h2>
          </div>
          <div>
            {story.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="recipe-method" aria-label="Оригинальный рецепт">
          <div class="section-heading">
            <p class="section-kicker">Оригинал</p>
            <h2>Что было написано в рецепте</h2>
          </div>

          <article class="recipe-method__block">
            <h3>РОГАЛИКИ</h3>
            <div class="recipe-method__content">
              <div class="recipe-method__ingredients">
                <p class="recipe-method__label">Ингредиенты</p>
                <ul>
                  {originalRecipe.ingredients.map((ingredient) => <li>{ingredient}</li>)}
                </ul>
              </div>
              <div class="recipe-method__steps">
                <p class="recipe-method__label">Способ</p>
                {originalRecipe.steps.map((step) => <p>{step}</p>)}
              </div>
            </div>
          </article>
        </section>

        <section class="recipe-prose grid-section">
          <div>
            <p class="section-kicker">Детство</p>
            <h2>Творог, варенье и гордость изобретателя</h2>
          </div>
          <div>
            {memory.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="recipe-notes">
          <div>
            <p class="section-kicker">Сегодняшняя проба</p>
            <h2>Что стало понятно после выпечки</h2>
          </div>
          <ul>
            {notes.map((note) => <li>{note}</li>)}
          </ul>
        </section>

        <section class="recipe-prose grid-section">
          <div>
            <p class="section-kicker">После</p>
            <h2>От рогаликов к круассанам</h2>
          </div>
          <div>
            {afterword.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <RecipeActions title="Рогалики" />
      </article>
    </main>

    <footer class="recipe-footer">
      <div>
        <span>KAIGHI</span>
        <p>Кухня как продолжение памяти</p>
      </div>
      <nav aria-label="Нижняя навигация">
        <a href="/">Главная</a>
        <a href="/kitchen/">Кухня</a>
        <a href="/stories/">Рассказы</a>
        <a href="mailto:hello@kaighi.org">hello@kaighi.org</a>
      </nav>
    </footer>
  </body>
</html>
