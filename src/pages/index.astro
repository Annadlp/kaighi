---
import "../styles/global.css";

const sections = [
  { href: "/podcast/", label: "Подкаст" },
  { href: "#stories", label: "Рассказы" },
  { href: "#night-tales", label: "Предания" },
  { href: "#kitchen", label: "Кухня" },
  { href: "#blog", label: "Блог" },
  { href: "#contacts", label: "Контакты" },
];

const publications = [
  "Устные истории Наукана",
  "Архив семейных фотографий",
  "Новые тексты о языке и памяти",
];

const nightTales = [
  {
    title: "Итака красива издалека",
    text: "Пенелопа перестает быть символом ожидания и впервые смотрит на остров глазами человека, который уходит.",
    label: "Новое предание",
    href: "/night-tales/itaka-krasiva-izdaleka/",
  },
  {
    title: "Когда море говорит шепотом",
    text: "Мифы о воде, береговой тьме и голосах, которые слышны только тем, кто возвращается домой поздно.",
    label: "Миф",
  },
  {
    title: "Франчины сказки у огня",
    text: "Короткие авторские сказки для ночного чтения: смешные, тревожные и нежные, как разговор перед сном.",
    label: "Сказки",
  },
  {
    title: "Звезды над старым Науканом",
    text: "Предания о пути, памяти и небе, где каждая история держит направление лучше любого компаса.",
    label: "Предание",
  },
];

const notes = [
  { kind: "Рецензия", title: "Книга, которую читают вслух", meta: "12 июня" },
  { kind: "Кино", title: "Север без открытки", meta: "28 мая" },
  { kind: "Мысль", title: "Как смеяться, когда разговор серьезный", meta: "3 мая" },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="KAIGHI — общественная яранга в Наукане: подкаст, рассказы, публикации, кухня, блог и контакты."
    />
    <title>KAIGHI — общественная яранга в Наукане</title>
  </head>
  <body>
    <header class="site-header" aria-label="Главная навигация">
      <a class="brand" href="#top" aria-label="KAIGHI">KAIGHI</a>
      <nav>
        {sections.map((section) => <a href={section.href}>{section.label}</a>)}
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-label="KAIGHI">
        <img src="/images/kaighi-hero.png" alt="Яранга на северном берегу" />
        <div class="hero__content">
          <p class="eyebrow">Общественная яранга в Наукане</p>
          <h1>KAIGHI</h1>
          <p class="lede">
            Место для голосов, рецептов, памяти и смеха. Здесь встречаются
            подкаст, тексты, кухня и дневник живой северной культуры.
          </p>
        </div>
      </section>

      <section class="intro grid-section" aria-label="О проекте">
        <div>
          <p class="section-kicker">Что это</p>
          <h2>Яранга как открытая редакция</h2>
        </div>
        <p>
         <i> Kaighi </i> — так называли большую общественную ярангу в прибрежном Наукане — селе сибирских юпиков на Чукотке. Здесь собиралась община: пели, танцевали, рассказывали истории и отмечали большие праздники, в том числе Полъа — праздник кита. <br><br>

Сегодня <i> Kaighi </i> для нас — не только память о прошлом, но и открытая редакция, где вновь встречаются голоса, язык, семейные истории, фотографии, рецепты и свидетельства.

        </p>
      </section>

      <section class="feature grid-section" id="podcast">
        <div class="feature__image">
          <img src="/images/kaighi-podcast.png" alt="Стол с микрофонами для записи подкаста" />
        </div>
        <div class="feature__copy">
          <p class="section-kicker">Подкаст</p>
          <h2>Why Indigenous Women Love. And Laugh.</h2>
          <p>
            Разговоры о любви, родстве, работе, смехе, упрямстве и способах
            оставаться собой. Выпуски звучат как кухня после долгого дня:
            честно, близко, с паузами на чай.
          </p>
          <a class="text-link" href="/podcast/">Открыть страницу подкаста</a>
        </div>
      </section>

      <section class="split" id="stories">
        <div class="section-heading">
          <p class="section-kicker">Рассказы и публикации</p>
          <h2>Тексты, которые держат место</h2>
        </div>
        <div class="publication-list">
          {publications.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item}</h3>
              <p>
                Материал в редакции KAIGHI: бережная работа с голосами,
                архивами и контекстом.
              </p>
            </article>
          ))}
        </div>
      </section>

      <section class="night" id="night-tales">
        <div class="night__header">
          <p class="section-kicker">Мифы и Франчины сказки</p>
          <h2>Предания Ночи</h2>
          <p>
            Инвертированный раздел для историй, которые лучше звучат после
            заката: мифы, полусмешные страшилки, сказки Франчи и ночные
            записи из яранги.
          </p>
        </div>
        <div class="night__grid">
          {nightTales.map((tale, index) => (
            <article class={tale.href ? "night-card night-card--link" : "night-card"}>
              {tale.href ? <a href={tale.href} aria-label={`Открыть ${tale.title}`}></a> : null}
              <span>{tale.label ?? String(index + 1).padStart(2, "0")}</span>
              <h3>{tale.title}</h3>
              <p>{tale.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="kitchen" id="kitchen">
        <div class="section-heading">
          <p class="section-kicker">Кухня</p>
          <h2>Рецепты с фотографиями</h2>
        </div>
        <div class="recipe-card">
          <img src="/images/kaighi-kitchen.png" alt="Копченая рыба, ягоды, лепешки и чай" />
          <div>
            <p class="recipe-card__label">Первый рецепт</p>
            <h3>Копченая рыба с ягодами и ржаной лепешкой</h3>
            <p>
              Простая тарелка для общего стола: соленое, кислое, теплое и
              терпкое. Формат раздела рассчитан на пошаговые рецепты, истории
              ингредиентов и фотографии готового блюда.
            </p>
          </div>
        </div>
      </section>

      <section class="blog" id="blog">
        <div class="section-heading">
          <p class="section-kicker">Блог</p>
          <h2>Заметки, рецензии, мысли</h2>
        </div>
        <div class="note-grid">
          {notes.map((note) => (
            <article>
              <p>{note.kind}</p>
              <h3>{note.title}</h3>
              <span>{note.meta}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="contacts grid-section" id="contacts">
        <div>
          <p class="section-kicker">Контакты</p>
          <h2>Напишите в KAIGHI</h2>
        </div>
        <div class="contacts__details">
          <a href="mailto:hello@kaighi.org">hello@kaighi.org</a>
          <p>Для подкаста, публикаций, рецептов, архивных материалов и встреч.</p>
        </div>
      </section>
    </main>

    <footer>
      <span>KAIGHI</span>
      <p>Общественная яранга в Наукане</p>
    </footer>
  </body>
</html>
