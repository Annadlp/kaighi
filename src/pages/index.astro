---
import "../styles/global.css";

const sections = [
  { href: "/podcast/", label: "Подкаст" },
  { href: "/stories/", label: "Рассказы" },
  { href: "/night-tales/", label: "Предания" },
  { href: "/kitchen/", label: "Кухня" },
  { href: "#blog", label: "Блог" },
  { href: "#contacts", label: "Контакты" },
];

const publications = [
  {
    title: "Язык. La Lengua",
    text: "Рассказ о Малиналли, переводе как власти, вине без одного языка и месте между двумя мирами.",
    label: "Новый рассказ",
    href: "/stories/la-lengua/",
  },
  {
    title: "Гамбит Ануки",
    text: "Рассказ о шахматной партии во время обыска, придуманном на китобойном судне гамбите и игре, которую нужно сыграть до конца.",
    label: "Рассказ",
    href: "/stories/gambit-anuki/",
  },
  {
    title: "Нувукак",
    text: "Рассказ о Нутэке, больничной палате, языке льда и памяти о селе, которое остается живым.",
    label: "Рассказ",
    href: "/stories/nuvukak/",
  },
  {
    title: "Ияин",
    text: "Голос старого охотника из Нувукака о первой добыче, долге, море, старших и песне как способе не сдаться.",
    label: "Рассказ",
    href: "/stories/iyain/",
  },
  {
    title: "Зеленый помидор",
    text: "Историческая миниатюра о последнем выборе взрослого, детях и руке, которую нельзя разжать.",
    label: "Историческая миниатюра",
    href: "/stories/zelenyi-pomidor/",
  },
  {
    title: "Мастер на все руки",
    text: "Рассказ о бывшем помощнике шерифа, самодельной клетке, власти и запахе вины, от которого невозможно отмыться.",
    label: "Рассказ",
    href: "/stories/master-na-vse-ruki/",
  },
  {
    title: "Собственный вектор",
    text: "Рассказ-притча о координатах, власти описания и направлении, которое невозможно навязать извне.",
    label: "Рассказ-притча",
    href: "/stories/sobstvennyi-vektor/",
  },
];

const entryPoints = [
  {
    title: "Читать",
    text: "Рассказы, исторические фантазии и голоса людей, которые остаются с нами после последней строки.",
    href: "#stories",
  },
  {
    title: "Слушать",
    text: "Подкаст Why Indigenous Women Love. And Laugh. — разговоры о любви, языке, памяти и смехе.",
    href: "/podcast/",
  },
  {
    title: "Готовить",
    text: "Рецепты с фотографиями и историями: кухня как способ вспомнить дом, книгу, маму, берег.",
    href: "#kitchen",
  },
  {
    title: "Вспоминать",
    text: "Предания, семейная память, мифы и вопросы, которые возвращают человека к своему месту.",
    href: "#night-tales",
  },
];

const dailyQuotes = [
  {
    quote: "«Память — это не способность, а обязанность.»",
    source: "Из рассказа «Нувукак»",
    caption: "Нутэк вспоминает Наукан, язык льда, ветер и место, которое остается живым.",
    href: "/stories/nuvukak/",
  },
  {
    quote: "«Добыча — это не победа. Это долг.»",
    source: "Из рассказа «Ияин»",
    caption: "Ияин вспоминает первую птицу, первую нерпу и то, как человек получает место среди людей.",
    href: "/stories/iyain/",
  },
  {
    quote: "«Прочитать меня можно только целиком.»",
    source: "Из рассказа «Собственный вектор»",
    caption: "Рассказ-притча о координатах, власти описания и направлении, которое невозможно навязать извне.",
    href: "/stories/sobstvennyi-vektor/",
  },
  {
    quote: "«Время не лжет. Это я лгала.»",
    source: "Из предания «Итака красива издалека»",
    caption: "Пенелопа впервые смотрит на Итаку глазами человека, который уходит.",
    href: "/night-tales/itaka-krasiva-izdaleka/",
  },
  {
    quote: "«Где потеряли — там и бегает.»",
    source: "Из «Сказок бабушки Наукыкэ»",
    caption: "Короткие сказания о море, сиротах, зверях, превращениях и помощи из другого мира.",
    href: "/night-tales/grandmother-naukyke/",
  },
  {
    quote: "«Наш Рай - это камни, ветер и крики чаек.»",
    source: "Из мифа «Миф о тех, чей рай - не сад, а берег»",
    caption: "Миф о душах, которые не пришли в сады, потому что их рай был на берегу.",
    href: "/night-tales/rai-ne-sad-a-bereg/",
  },
];

const nightTales = [
  {
    title: "Миф о тех, чей рай - не сад, а берег",
    text: "Миф о душах тринадцати охотников и их семей, для которых рай оказался камнями, ветром и криками чаек.",
    label: "Новый миф",
    href: "/night-tales/rai-ne-sad-a-bereg/",
  },
  {
    title: "Итака красива издалека",
    text: "Пенелопа перестает быть символом ожидания и впервые смотрит на остров глазами человека, который уходит.",
    label: "Новое предание",
    href: "/night-tales/itaka-krasiva-izdaleka/",
  },
  {
    title: "Асая",
    text: "Темное предание о красоте, зависти, живой парке и реке, которая знает цену чужой жизни.",
    label: "Новое предание",
    href: "/night-tales/asaya/",
  },
  {
    title: "Сказки бабушки Наукыкэ",
    text: "Короткие сказания о море, сиротах, белухе, зайце, касатке и паучьей нити, которая спасает жизнь.",
    label: "Сказания",
    href: "/night-tales/grandmother-naukyke/",
  },
  {
    title: "Зевс, Гипнос и Тот, Кто Ночью Не Спал",
    text: "Ночной миф о споре Зевса и Гипноса, власти как привычке и человеке, который услышал слишком простой разговор богов.",
    label: "Миф к десерту",
    href: "/night-tales/zeus-hypnos-i-tot-kto-nochyu-ne-spal/",
  },
];

const featuredPublications = publications.slice(0, 4);
const featuredNightTales = nightTales.slice(0, 4);

const notes = [
  { kind: "Рецензия", title: "Книга, которую читают вслух", meta: "12 июня" },
  { kind: "Кино", title: "Север без открытки", meta: "28 мая" },
  { kind: "Мысль", title: "Как смеяться, когда разговор серьезный", meta: "3 мая" },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="KAIGHI — общественная яранга в Наукане: подкаст, рассказы, публикации, кухня, блог и контакты."
    />
    <title>KAIGHI — общественная яранга в Наукане</title>
  </head>
  <body>
    <header class="site-header" aria-label="Главная навигация">
      <a class="brand" href="#top" aria-label="KAIGHI">KAIGHI</a>
      <nav>
        {sections.map((section) => <a href={section.href}>{section.label}</a>)}
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-label="KAIGHI">
        <img src="/images/kaighi-hero.png" alt="Яранга на северном берегу" />
        <div class="hero__content">
          <p class="eyebrow">Общественная яранга в Наукане</p>
          <h1>KAIGHI</h1>
          <p class="lede">
            Место для голосов, рецептов, памяти и смеха. Здесь собираются
            истории о доме, языке, родстве, утрате, еде и том, как человек
            остается связанным со своими.
          </p>
        </div>
      </section>

      <section class="entryways" aria-label="Что можно найти в KAIGHI">
        <div class="section-heading">
          <p class="section-kicker">Если вы впервые здесь</p>
          <h2>Выберите, с чего войти в ярангу</h2>
        </div>
        <div class="entryway-grid">
          {entryPoints.map((item) => (
            <article>
              <a href={item.href} aria-label={`Перейти: ${item.title}`}></a>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="daily-quote" aria-label="Цитата дня">
        <div class="daily-quote__label">
          <p class="section-kicker">Цитата дня</p>
          <span id="daily-quote-source">{dailyQuotes[0].source}</span>
        </div>
        <figure>
          <blockquote id="daily-quote-text">{dailyQuotes[0].quote}</blockquote>
          <figcaption id="daily-quote-caption">{dailyQuotes[0].caption}</figcaption>
        </figure>
        <a class="text-link" id="daily-quote-link" href={dailyQuotes[0].href}>Читать</a>
      </section>

      <script define:vars={{ dailyQuotes }}>
        const dayIndex = Math.floor(Date.now() / 86400000) % dailyQuotes.length;
        const quote = dailyQuotes[dayIndex];
        document.getElementById("daily-quote-source").textContent = quote.source;
        document.getElementById("daily-quote-text").textContent = quote.quote;
        document.getElementById("daily-quote-caption").textContent = quote.caption;
        document.getElementById("daily-quote-link").setAttribute("href", quote.href);
      </script>

      <section class="feature grid-section" id="podcast">
        <div class="feature__image">
          <img src="/images/kaighi-podcast.png" alt="Стол с микрофонами для записи подкаста" />
        </div>
        <div class="feature__copy">
          <p class="section-kicker">Подкаст</p>
          <h2>Why Indigenous Women Love. And Laugh.</h2>
          <p>
            Разговоры о любви, родстве, работе, смехе, упрямстве и способах
            оставаться собой. Выпуски звучат как кухня после долгого дня:
            честно, близко, с паузами на чай.
          </p>
          <a class="text-link" href="/podcast/">Открыть страницу подкаста</a>
        </div>
      </section>

      <section class="split" id="stories">
        <div class="section-heading">
          <p class="section-kicker">Новые тексты</p>
          <h2>С чего начать читать</h2>
        </div>
        <div class="publication-list">
          {featuredPublications.map((item, index) => (
            <article class={item.href ? "publication-card publication-card--link" : "publication-card"}>
              {item.href ? <a href={item.href} aria-label={`Открыть ${item.title}`}></a> : null}
              <span>{item.label ?? String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
        <a class="section-more" href="/stories/">Все рассказы</a>
      </section>

      <section class="memory-prompt">
        <div>
          <p class="section-kicker">Своя память</p>
          <h2>Какая история живет в вашей семье?</h2>
        </div>
        <p>
          Иногда память начинается не с архива, а с фразы, блюда, фотографии,
          странной книги на полке, песни, которую кто-то помнит не до конца.
          KAIGHI держит место и для таких частных следов: из них складывается
          большая человеческая карта.
        </p>
      </section>

      <section class="night" id="night-tales">
        <div class="night__header">
          <p class="section-kicker">Мифы и Франчины сказки</p>
          <h2>Предания Ночи</h2>
          <p>
            Инвертированный раздел для историй, которые лучше звучат после
            заката: мифы, полусмешные страшилки, сказки Франчи и ночные
            записи из яранги.
          </p>
        </div>
        <div class="night__grid">
          {featuredNightTales.map((tale, index) => (
            <article class={tale.href ? "night-card night-card--link" : "night-card"}>
              {tale.href ? <a href={tale.href} aria-label={`Открыть ${tale.title}`}></a> : null}
              <span>{tale.label ?? String(index + 1).padStart(2, "0")}</span>
              <h3>{tale.title}</h3>
              <p>{tale.text}</p>
            </article>
          ))}
        </div>
        <a class="section-more section-more--dark" href="/night-tales/">Все предания</a>
      </section>

      <section class="kitchen" id="kitchen">
        <div class="section-heading">
          <p class="section-kicker">Кухня</p>
          <h2>Рецепты с фотографиями</h2>
        </div>
        <div class="recipe-stack">
          <div class="recipe-card">
            <img src="/images/rogaliki.jpg" alt="Домашние рогалики с сахарной пудрой" />
            <div>
              <p class="recipe-card__label">Почему появилась кухня</p>
              <h3>Рогалики</h3>
              <p>
                История о книге «500 блюд для северян», рецепте без яиц,
                твороге с вареньем и первом вкусе собственного изобретения.
              </p>
              <a class="recipe-card__link" href="/kitchen/rogaliki/">Открыть рецепт</a>
            </div>
          </div>
          <div class="recipe-card recipe-card--compact">
            <img src="/images/eclat-interdit.jpg" alt="Шоколадный десерт Éclat d’Interdit" />
            <div>
              <p class="recipe-card__label">Первый десерт</p>
              <h3>Éclat d’Interdit</h3>
              <p>
                Шоколадный купол о запрете, ночи и моменте, когда смертный
                осмеливается услышать слишком простую правду богов.
              </p>
              <a class="recipe-card__link" href="/kitchen/eclat-interdit/">Открыть рецепт</a>
            </div>
          </div>
        </div>
        <a class="section-more" href="/kitchen/">Все рецепты</a>
      </section>

      <section class="blog" id="blog">
        <div class="section-heading">
          <p class="section-kicker">Блог</p>
          <h2>Заметки, рецензии, мысли</h2>
        </div>
        <div class="note-grid">
          {notes.map((note) => (
            <article>
              <p>{note.kind}</p>
              <h3>{note.title}</h3>
              <span>{note.meta}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="contacts grid-section" id="contacts">
        <div>
          <p class="section-kicker">Контакты</p>
          <h2>Напишите в KAIGHI</h2>
        </div>
        <div class="contacts__details">
          <a href="mailto:hello@kaighi.org">hello@kaighi.org</a>
          <p>Для подкаста, публикаций, рецептов, архивных материалов и встреч.</p>
        </div>
      </section>

    </main>

    <footer class="site-footer">
      <div>
        <span>KAIGHI</span>
        <p>Общественная яранга в Наукане</p>
      </div>
      <nav aria-label="Нижняя навигация">
        <a href="/podcast/">Подкаст</a>
        <a href="/#stories">Рассказы</a>
        <a href="/#night-tales">Предания</a>
        <a href="/#kitchen">Кухня</a>
        <a href="mailto:hello@kaighi.org">hello@kaighi.org</a>
      </nav>
    </footer>
  </body>
</html>
